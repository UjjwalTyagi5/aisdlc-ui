# Template for backend/.env.test — the isolated test database's connection strings.
# Copy to backend/.env.test and fill in real values (same host/port/credentials as
# your backend/.env, DBNAME swapped for a database that is NOT the one your app uses).
#
# See docs/local-setup.md, "Test database" section, for why this file exists and how
# to (re)create the database it points at. Short version: tests/conftest.py loads this
# file before importing anything DB-related, so pytest never touches the real dev
# database — even a buggy test-cleanup fixture can only reach this one.

POSTGRES_CONN_STRING=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME_test
POSTGRES_SYNC_CONN_STRING=postgresql://USER:PASSWORD@HOST:5432/DBNAME_test
POSTGRES_MIGRATIONS_CONN_STRING=postgresql+asyncpg://SUPERUSER:PASSWORD@HOST:5432/DBNAME_test

# ── Artifact storage ──────────────────────────────────────────────────────────
# A STORE OF THE TEST SUITE'S OWN, for the same reason it has its own database. Without
# this, tests inherit `.env`'s ARTIFACT_STORAGE_ROOT and file their documents into the
# store the development app reads: the dev store ends up holding test output
# (brd.pdf, policy.pdf under invented tenant ids), and a test that tidies up could take a
# real document with it. Relative paths resolve against backend/ (see config/env.py).
ARTIFACT_STORAGE_ROOT=files/artifact-store-test
STORAGE_BACKEND=local
