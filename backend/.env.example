# ==============================================================================
# SDLC Platform - backend environment
# ------------------------------------------------------------------------------
# Copy this file to `.env` (in platform/backend/) and fill in the values.
#
# This file contains ONLY what an operator must configure to run the platform.
#
# Connector credentials (Azure DevOps PAT, Jira token, GitHub App key, Slack
# token, webhook signing secrets, OAuth client secrets) are NOT configured here.
# They live in Azure Key Vault and are written there automatically when an
# authorized user (connector:manage) connects a provider in the app - or by an
# operator via shared.keyvault.store_secret. All credential reads are KV-first.
#
# Optional/advanced knobs (model tiers, SLA hours, worker tuning, enterprise
# OIDC/SCIM, LiteLLM) have sensible code defaults and are omitted; a few are
# shown commented below. See config/env.py for the full list.
# ==============================================================================

# -- Runtime mode --------------------------------------------------------------
# local      = development (HS256 mock auth allowed, MemorySaver checkpointer ok)
# enterprise = production  (OIDC required, Postgres checkpointing mandatory)
AGENT_RUNTIME_MODE=local

# -- Service URLs --------------------------------------------------------------
AGENTIC_BASE_URL=http://localhost:8001
AGENTIC_WS_URL=ws://localhost:8001

# -- LLM providers (the platform's own keys) -----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional Gemini fallback for the requirements agent:
GOOGLE_API_KEY=

# -- Database - PostgreSQL -----------------------------------------------------
# App role (asyncpg). In production this MUST be a non-superuser, NON-BYPASSRLS
# role so row-level tenant isolation is enforced.
POSTGRES_CONN_STRING=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# LangGraph checkpointer (psycopg/sync URL - same database).
POSTGRES_SYNC_CONN_STRING=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Alembic migrations - MUST be a superuser / BYPASSRLS role (NOT the app role).
POSTGRES_MIGRATIONS_CONN_STRING=postgresql+asyncpg://SUPERUSER:PASSWORD@HOST:5432/DBNAME

# -- Redis ---------------------------------------------------------------------
# Used by the worker pool, inbound webhooks, and the JWT denylist.
REDIS_URL=redis://localhost:6379/0

# -- Temporal (orchestrator) ---------------------------------------------------
ENABLE_TEMPORAL=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=sdlc-dev

# -- Langfuse LLM observability (self-hosted OSS) ------------------------------
# Start the stack:  docker compose -f docker-compose.langfuse.yml up -d
# then create a project at http://localhost:3100 and paste the key pair below.
ENABLE_LANGFUSE=false
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -- Auth ----------------------------------------------------------------------
# Local dev: secret used to sign the BFF-minted HS256 JWT. Use a long random value.
JWT_SECRET_KEY=change-me-use-a-long-random-secret
# Enterprise OIDC (uncomment + set when AGENT_RUNTIME_MODE=enterprise):
# ENABLE_OIDC=true
# OIDC_ISSUER_URL=https://your-tenant.auth0.com/
# AUTH0_AUDIENCE=https://api.sdlc-platform
# OIDC_PROVIDER=auth0

# -- Azure (Key Vault + Blob) --------------------------------------------------
# Secret store + artifact storage. Auth via DefaultAzureCredential:
#   local -> `az login`     prod -> Managed Identity
# Required for connectors to resolve their KV secrets and for artifact uploads.
AZURE_KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net/
AZURE_BLOB_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net/
# Key Vault secret NAMES for the three Postgres DSNs (the secret VALUES live in Key Vault).
# Leave unset to use the default sdlc-{env}-postgres-*-conn-string convention
# (env from AGENT_RUNTIME_MODE, local->dev). Override only if your vault names differ.
# KV_SECRET_POSTGRES_CONN=sdlc-dev-postgres-conn-string
# KV_SECRET_POSTGRES_SYNC_CONN=sdlc-dev-postgres-sync-conn-string
# KV_SECRET_POSTGRES_MIGRATIONS_CONN=sdlc-dev-postgres-migrations-conn-string

# -- CORS ----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (the frontend origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- Connector config (NON-secret) ---------------------------------------------
# Provider *credentials* live in Key Vault. Only the non-secret Azure DevOps org
# URL is set here (leave blank if you don't use Azure DevOps).
ADO_ORG_URL=

# -- Feature flags -------------------------------------------------------------
ENABLE_WORKER_POOL=false
ENABLE_WEBHOOK_TRIGGERS=false
# ENABLE_LITELLM=false
# LITELLM_BASE_URL=http://localhost:4000

# -- Secret store (DB backend for local dev without Azure Key Vault) ------------
# Fernet key for encrypting secrets in the app_secrets table (DB backend).
# Required when AZURE_KEY_VAULT_URL is not set. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_STORE_KEY=
