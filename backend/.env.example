# ==============================================================================
# SDLC Platform - backend environment
# ------------------------------------------------------------------------------
# Copy this file to `.env` (in platform/backend/) and fill in the values.
#
# This file contains ONLY what an operator must configure to run the platform.
#
# NO CONNECTOR VALUE OF ANY KIND BELONGS IN THIS FILE, and there is no longer
# any that can be set here. Not a credential (Azure DevOps PAT, Jira token,
# Slack bot token), not a webhook signing secret, not an OAuth client secret,
# not a site URL. All of them are PER-TENANT: an authorized user
# (connector:manage) adds them on the Integrations page and they go to that
# tenant's own secret store - Key Vault in production, an encrypted DB table
# locally. There is no environment fallback for any of them, deliberately: a
# platform-wide value would let a tenant that never connected a provider
# transact with somebody else's credential.
#
# Optional/advanced knobs (worker tuning, enterprise OIDC/SCIM, LiteLLM) have
# sensible code defaults and are omitted; a few are shown commented below.
# See config/env.py for the full list.
# ==============================================================================

# -- Runtime mode --------------------------------------------------------------
# local      = development (HS256 mock auth allowed, MemorySaver checkpointer ok)
# enterprise = production  (OIDC required, Postgres checkpointing mandatory)
AGENT_RUNTIME_MODE=local

# -- Service URLs --------------------------------------------------------------
AGENTIC_BASE_URL=http://localhost:8001
AGENTIC_WS_URL=ws://localhost:8001

# -- LLM providers (the platform's own keys) -----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional Gemini fallback for the requirements agent:
GOOGLE_API_KEY=

# -- Database - PostgreSQL -----------------------------------------------------
# App role (asyncpg). In production this MUST be a non-superuser, NON-BYPASSRLS
# role so row-level tenant isolation is enforced.
POSTGRES_CONN_STRING=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# LangGraph checkpointer (psycopg/sync URL - same database).
POSTGRES_SYNC_CONN_STRING=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Alembic migrations - MUST be a superuser / BYPASSRLS role (NOT the app role).
POSTGRES_MIGRATIONS_CONN_STRING=postgresql+asyncpg://SUPERUSER:PASSWORD@HOST:5432/DBNAME

# -- Redis ---------------------------------------------------------------------
# Used by the worker pool, inbound webhooks, and the JWT denylist.
REDIS_URL=redis://localhost:6379/0


# -- Langfuse LLM observability (self-hosted OSS) ------------------------------
# Start the stack:  docker compose -f docker-compose.langfuse.yml up -d
# then create a project at http://localhost:3100 and paste the key pair below.
ENABLE_LANGFUSE=false
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -- The single organization + its admin ---------------------------------------
# The platform hosts exactly ONE organization; nothing in the product creates another.
# It is seeded at startup if absent, and every email below is bound to it as org_admin.
# Self-serve signup joins this same org with NO permissions until an admin grants a role.
# Leave the admin vars blank and no organization is created at all (signup returns 503).
DEFAULT_ORG_SLUG=pwc
DEFAULT_ORG_NAME=PwC
ORG_ADMIN_EMAILS=
ORG_ADMIN_PASSWORD=

# -- Auth ----------------------------------------------------------------------
# Local dev: secret used to sign the BFF-minted HS256 JWT. Use a long random value.
JWT_SECRET_KEY=change-me-use-a-long-random-secret
# Enterprise OIDC (uncomment + set when AGENT_RUNTIME_MODE=enterprise):
# ENABLE_OIDC=true
# OIDC_ISSUER_URL=https://your-tenant.auth0.com/
# AUTH0_AUDIENCE=https://api.sdlc-platform
# OIDC_PROVIDER=auth0

# -- WHERE SECRETS COME FROM ---------------------------------------------------
# The one switch. `dev` reads every secret below from THIS FILE and never contacts
# Azure — no credential, no network, no `az login`. Anything else (prod, staging,
# uat …) means the secrets live in Azure Key Vault and this file is not trusted to
# hold them: config/secret_bootstrap.py loads them into the environment at startup,
# before any setting is read.
#
# LEAVE THIS AS dev LOCALLY. Set ENV on the deployed host instead — a laptop that
# says `prod` will try to reach a vault it has no business reading, and fail closed.
#
# Failing closed is the deliberate behaviour: with ENV != dev and the vault
# unreachable, the process REFUSES TO START rather than falling back to whatever
# this file happens to contain. The fallback is how an API ends up live on
# JWT_SECRET_KEY=change-me-in-production with nothing in the logs to show for it.
#
# To set a vault up:  .\scripts\setup_key_vault.ps1 -Env prod
# To fill it:         python -m scripts.seed_key_vault --env prod --dry-run
ENV=dev

# Optional. Secret names are `sdlc-{ENV}-{var-with-dashes}` — so JWT_SECRET_KEY is
# `sdlc-prod-jwt-secret-key` — which lets one vault serve several environments
# without collisions. Set this to override the whole prefix (empty string for none)
# when a vault is dedicated to a single environment.
# KV_SECRET_PREFIX=

# -- Azure (Key Vault + Blob) --------------------------------------------------
# Secret store + artifact storage. Auth via DefaultAzureCredential:
#   local -> `az login`     prod -> Managed Identity
# Required for connectors to resolve their KV secrets and for artifact uploads.
# REQUIRED when ENV is not `dev`; startup fails without it.
AZURE_KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net/
AZURE_BLOB_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net/
# Key Vault secret NAMES for the three Postgres DSNs (the secret VALUES live in Key Vault).
# Leave unset to use the default sdlc-{env}-postgres-*-conn-string convention
# (env from AGENT_RUNTIME_MODE, local->dev). Override only if your vault names differ.
# KV_SECRET_POSTGRES_CONN=sdlc-dev-postgres-conn-string
# KV_SECRET_POSTGRES_SYNC_CONN=sdlc-dev-postgres-sync-conn-string
# KV_SECRET_POSTGRES_MIGRATIONS_CONN=sdlc-dev-postgres-migrations-conn-string

# -- CORS ----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (the frontend origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- Connector config ----------------------------------------------------------
# Nothing to set here, including the things that used to be exceptions.
#
# OAuth client ids/secrets and the GitHub App key are gone with the OAuth flow they
# fed - a provider is connected by pasting a credential the tenant owns, so the
# platform no longer registers an app or holds a client secret on anyone's behalf.
#
# Inbound webhook signing secrets are gone too. They were justified as unavoidably
# platform-wide because "a signature is verified before the request is attributed to
# a tenant" - which was not true here: the route is /webhooks/{connector}/{tenant_id}
# and the tenant is a path parameter. Each tenant now registers the webhook in its
# own GitHub org / Jira site / Slack app with its own secret and pastes it into
# Integrations.

# -- Feature flags -------------------------------------------------------------
ENABLE_WORKER_POOL=false
ENABLE_WEBHOOK_TRIGGERS=false
# ENABLE_LITELLM=false
# LITELLM_BASE_URL=http://localhost:4000

# -- Secret store (DB backend for local dev without Azure Key Vault) ------------
# Fernet key for encrypting secrets in the app_secrets table (DB backend).
# Required when AZURE_KEY_VAULT_URL is not set. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_STORE_KEY=

# -- Outbound email (onboarding invites + password reset) -----------------------
# ENTIRELY OPTIONAL FOR LOCAL DEV. With SMTP_HOST unset the backend LOGS the whole
# message — set-password link included — at WARNING and carries on, so onboarding and
# "forgot password" are fully exercisable with no mail server. Copy the link out of the
# backend log.
#
# To send for real. Gmail needs 2FA on the account plus a 16-char App Password
# (Google removed plain-password SMTP auth). Fine for dev; a poor production choice for
# THIS traffic — the From address cannot be your own domain, there is no SPF/DKIM
# alignment, and a set-password link in a spam folder means the user cannot get in.
# Any provider works (Azure Communication Services, SES, SendGrid, Mailgun): all speak
# SMTP, so switching is configuration, not code.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=<16-char app password, no spaces>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_FROM=you@gmail.com
# EMAIL_FROM_NAME=SDLC Platform
#
# The BROWSER-facing origin the emailed links point at — NOT AGENTIC_BASE_URL, which is
# this API. A link built against the API host goes nowhere. Defaults to localhost:3000,
# so local dev needs no value.
# PUBLIC_APP_URL=http://localhost:3000
#
# Link lifetimes, in MINUTES (these were *_TTL_HOURS; an hours-based setting could not
# express a ten-minute link). Both default to 10.
#
# A live token is a credential, so short is the safer default. The invite is the one to
# reconsider: it reaches somebody who is NOT expecting it and is the only way into an
# account with no password yet, so at 10 minutes most invites will be opened after they
# have already expired and will need an admin to resend. Raise this one — 1440 is a day —
# if onboarding is generating resend requests.
# INVITE_TOKEN_TTL_MINUTES=10
# RESET_TOKEN_TTL_MINUTES=10

# ─────────────────────────────────────────────────────────────────────────────
# Settings that were read by config/env.py but never documented here (the
# .env.example completeness gate, scripts/check_env_example.py, now covers them).
# All have working defaults — set one only to change that default.
# ─────────────────────────────────────────────────────────────────────────────
#
# TENANT credential vault. Per-tenant credentials the app both READS and WRITES:
# BYOK model keys and connector tokens. Kept apart from AZURE_KEY_VAULT_URL so the
# app's identity can hold "Key Vault Secrets Officer" (write) here WITHOUT holding
# it over jwt-secret-key. Unset falls back to AZURE_KEY_VAULT_URL, which is the
# single-vault behaviour every existing deployment already has.
# Provision with: .\scripts\setup_key_vault.ps1 -Env prod -AppId <id> -TenantVault
# AZURE_TENANT_VAULT_URL=https://sdlc-kv-tenant-prod.vault.azure.net/
#
# Budget guard behaviour when a spend read fails (Redis/DB down). Default false =
# FAIL OPEN, so a monitoring outage does not block every run. Set true to reject
# runs whenever spend cannot be confirmed.
# BUDGET_ENFORCE_FAIL_CLOSED=false
#
# Where the dev agent checks out repos, and where the documentation agent writes
# generated docs. Both default under backend/files/.
# DEV_WORKSPACE_ROOT=./files/dev-workspace
# DOCS_OUTPUT_ROOT=./files/generated-docs
#
# Connector health probes re-check every connector every 30s on the request event
# loop. Useful in a deployed environment; in local dev it saturates a core and adds
# roughly a second to every request. Default true.
# ENABLE_CONNECTOR_HEALTH_PROBES=true
#
# MCP (Model Context Protocol) — user-registered servers exposed as agent tools.
# MCP_ENABLED gates the whole feature. MCP_STDIO_ENABLED additionally allows the
# stdio transport, which SPAWNS A SUBPROCESS ON THE BACKEND HOST — leave it off
# except in trusted single-tenant deployments, and keep the allowlist tight.
# An empty allowlist permits no stdio command even when MCP_STDIO_ENABLED=true.
# MCP_ENABLED=false
# MCP_STDIO_ENABLED=false
# MCP_STDIO_COMMAND_ALLOWLIST=npx,uvx,python
# MCP_CONNECT_TIMEOUT_SECONDS=20
# MCP_TOOL_TIMEOUT_SECONDS=60
#
# Reconcile the RBAC role/permission catalog from code on boot. Startup refuses to
# start on catalog drift; this decides whether it repairs or just reports.
# RBAC_CATALOG_AUTOREPAIR=false
#
# Testing agent runs Selenium Chrome visibly by default (local dev). Set true on
# servers and enterprise deploys where there is no display for a browser window.
# TESTING_AGENT_HEADLESS=false
