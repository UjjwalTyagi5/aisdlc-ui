# ---------------------------------------------------------------------------
# Static/mock-mode environment — this project has no backend integration.
# Every resource surface is served by MSW fixtures (mocks/handlers.ts) and
# auth is the local role-picker session. Do NOT set NEXT_PUBLIC_API_MOCKS=off
# or NEXT_PUBLIC_AUTH_MODE=local here — those require a running FastAPI
# backend on FASTAPI_INTERNAL_URL, which this project intentionally has none
# of. If real-backend wiring is ever needed, put those overrides in a
# gitignored .env.local instead of changing this file.
# ---------------------------------------------------------------------------

# Transport mode — "on" (or unset) serves every resource surface from MSW
# fixtures. MSW is also loaded in Storybook and vitest regardless of this
# setting.
NEXT_PUBLIC_API_MOCKS=on

# Auth mode — "mock" is the role-picker local session; the only mode this
# static frontend supports without a backend.
NEXT_PUBLIC_AUTH_MODE=mock
 
# Server-only — base URL of the FastAPI unified backend.
# Must NOT have a trailing slash.
# This env var is never exposed to the browser (no NEXT_PUBLIC_ prefix).
FASTAPI_INTERNAL_URL=http://localhost:8001
 
# Shared symmetric secret between Next.js BFF and FastAPI JWT middleware.
# Must match the value set in the FastAPI process (JWT_SECRET_KEY in agentic_app).
#
# Deliberately EMPTY in the committed file — this env is tracked in git, and a
# signing key in a tracked file is a published signing key. Nothing reads it
# while NEXT_PUBLIC_API_MOCKS=on, which is the only mode this project runs in.
# If you ever wire up the real backend, put the value in .env.local (gitignored)
# rather than filling it in here.
JWT_SECRET_KEY=
 
# Auth0 credentials — required only when NEXT_PUBLIC_AUTH_MODE=auth0.
# AUTH0_SECRET=<random-32-byte-hex>
# AUTH0_BASE_URL=http://localhost:3000
# AUTH0_ISSUER_BASE_URL=https://<tenant>.auth0.com
# AUTH0_CLIENT_ID=<client-id>
# AUTH0_CLIENT_SECRET=<client-secret>