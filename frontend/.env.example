# ------------------------------------------------------------------
# Auth mode — one of: "mock" (default) | "auth0"
# Mock mode sets a base64 JSON cookie so UI work is unblocked.
# Flip to "auth0" once the tenant below is configured.
# ------------------------------------------------------------------
NEXT_PUBLIC_AUTH_MODE=mock

# ------------------------------------------------------------------
# API mock transport — set to "off" when running against the real
# FastAPI backend. Leave blank or set to "on" to use MSW mocks
# (Storybook and component tests always use MSW regardless).
# ------------------------------------------------------------------
# NEXT_PUBLIC_API_MOCKS=off

# ------------------------------------------------------------------
# BFF → FastAPI internal transport (SERVER-ONLY — no NEXT_PUBLIC_ prefix)
# These vars are used only in server components and route handlers.
# The browser never sees them.
# ------------------------------------------------------------------
# URL of the FastAPI unified backend (from milestone-2).
# Default: http://localhost:8001
FASTAPI_INTERNAL_URL=http://localhost:8001

# Shared HS256 secret — must match JWT_SECRET_KEY in the FastAPI .env.
# Generate: openssl rand -hex 32
# NEVER prefix with NEXT_PUBLIC_ — this is a server-only secret.
JWT_SECRET_KEY=

# ------------------------------------------------------------------
# Auth0 config — only required when NEXT_PUBLIC_AUTH_MODE=auth0
# Create an app at https://manage.auth0.com → Applications → Regular Web
# Callback URLs:  http://localhost:3000/auth/callback
# Logout URLs:    http://localhost:3000
# ------------------------------------------------------------------
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=           # 32-byte hex — run: openssl rand -hex 32
# APP_BASE_URL=http://localhost:3000
# AUTH0_SCOPE="openid profile email offline_access"
# AUTH0_AUDIENCE=         # must match AUTH0_AUDIENCE in the FastAPI backend .env

# ------------------------------------------------------------------
# M7.3 OIDC SSO gate — frontend mirror of the backend ENABLE_OIDC flag.
# false (default): mock sign-in panel is shown; BFF mints HS256 tokens.
# true: Auth0 SSO button is shown; BFF forwards the Auth0 RS256 access
# token instead of minting HS256 (bearerForRequest branch in bff/client.ts).
# Set in lockstep with ENABLE_OIDC in the FastAPI backend .env.
# ------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_OIDC=false
