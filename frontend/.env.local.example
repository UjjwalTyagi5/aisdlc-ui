# ---------------------------------------------------------------------------
# Real-mode environment (NEXT_PUBLIC_API_MOCKS=off)
#
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# Transport mode — set to "off" to route resource surfaces through the BFF to
# the real FastAPI backend instead of MSW mocks. MSW is still loaded in
# Storybook and vitest regardless of this setting.
NEXT_PUBLIC_API_MOCKS=off

# Auth mode — keep "mock" for local development without Auth0 credentials.
# Set to "auth0" in staging/production environments.
NEXT_PUBLIC_AUTH_MODE=mock

# Server-only — base URL of the FastAPI unified backend.
# Must NOT have a trailing slash.
# This env var is never exposed to the browser (no NEXT_PUBLIC_ prefix).
FASTAPI_INTERNAL_URL=http://localhost:8001

# Shared symmetric secret between Next.js BFF and FastAPI JWT middleware.
# Must match the value set in the FastAPI process (JWT_SECRET_KEY in agentic_app).
JWT_SECRET_KEY=<shared-with-fastapi>

# Auth0 credentials — required only when NEXT_PUBLIC_AUTH_MODE=auth0.
# AUTH0_SECRET=<random-32-byte-hex>
# AUTH0_BASE_URL=http://localhost:3000
# AUTH0_ISSUER_BASE_URL=https://<tenant>.auth0.com
# AUTH0_CLIENT_ID=<client-id>
# AUTH0_CLIENT_SECRET=<client-secret>
