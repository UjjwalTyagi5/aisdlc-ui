# Repo-root ignores. The frontend keeps its own frontend/.gitignore, which
# still governs everything under that subtree; the rules here are for the
# backend and for anything that sits at the root.

# ── Backend: Python environment and caches ───────────────────────────────
backend/.venv/
**/__pycache__/
*.py[cod]
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Agent run workspaces — generated per pipeline run, not source
backend/files/

# Agent scratch that kept getting committed. The agents write these with bare
# cwd-relative paths ("outputs/pdd.docx", "logs.db"), so whichever directory the
# process happens to start in accumulates them. Nothing reads them back.
backend/**/outputs/
backend/**/INPUT/
backend/**/temp/
backend/**/logs.db

# Superpowers subagent-driven-development scratch workspace (ledgers, briefs, reports)
.superpowers/

# Superpowers isolated implementation worktrees
.worktrees/

# Local Temporal dev-server state
backend/.temporal-dev.db
backend/.temporal-dev.db-journal

# Logs
*.log

# ── Secrets ──────────────────────────────────────────────────────────────
# The real backend .env holds live API keys, a JWT signing key and Postgres
# credentials. backend/.env.example carries the shape instead.
backend/.env

# Same class of local credentials, for the isolated test database
# (docs/local-setup.md, "Test database"). backend/.env.test.example carries the shape.
backend/.env.test

# A root-level .env (used by some worktrees for local overrides) can hold the
# same class of live secrets — never let it slip in un-ignored.
/.env

# Local persona logins, written by backend/scripts/seed_dev_personas.py. The
# password in it is weak and shared by design — it exists so a developer can
# switch roles quickly. Committing the file would put a working credential list
# in the repo, and the fact that it only works locally today is not a property
# anyone should have to keep true.
DEV_LOGINS.txt

# Local, personal project-overview notes — compiled reference, not a source doc
/PROJECT.md

# ── Tooling ──────────────────────────────────────────────────────────────
# settings.json is shared, settings.local.json accumulates local paths
.claude/settings.local.json
.DS_Store
Thumbs.db

# Database dumps taken before risky merges — real tenant data, never committed.
backups/

# Hand-made .env backups (e.g. .env.bak.premerge) carry the same live credentials
# the ignored .env does; the suffix must not be what decides whether they leak.
backend/.env.bak*
backend/.env.*.bak
